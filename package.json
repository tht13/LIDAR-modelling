{
  "name": "lidar-modelling",
  "version": "1.0.0",
  "description": "LIDAR point cloud visualization tool for Desktop (Electron) and Web",
  "main": "main.js",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "webpack serve --mode development --open",
    "dev:electron": "concurrently \"webpack --watch --mode development\" \"electron main.js\"",
    "build": "npm run build:web",
    "build:web": "webpack --mode production",
    "build:electron": "webpack --mode production",
    "start": "npm run start:web",
    "start:web": "webpack serve --mode production --open",
    "start:electron": "electron main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git"
  },
  "author": "Thomas Haakon Townsend",
  "dependencies": {
    "geotiff": "^3.0.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.1.2",
    "electron": "^37.3.1",
    "jsdom": "^29.1.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
